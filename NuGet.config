<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    NuGet feeds for building this service.

    The organization feed is where the Nur.Tricenter.* platform kernels are
    published. This service consumes Nur.Tricenter.Access and Nur.Tricenter.Observability from
    it, so the checkout builds on its own: no sibling repository is needed on disk, and the
    Docker image builds from this folder as the context.

    AUTHENTICATION

    GitHub Packages expects a classic personal access token. It needs the read:packages scope to
    restore and write:packages to push. Never put the token in this file.

    Register the feed once, from a shell, replacing the two placeholders:

      dotnet nuget add source https://nuget.pkg.github.com/Nur-tricenter/index.json
        [name] Nur-tricenter
        [username] YOUR_GITHUB_USER
        [password] YOUR_TOKEN

    Or set the two environment variables below on the machine, and the credentials block at the
    bottom of this file picks them up automatically:

      setx NUGET_USERNAME YOUR_GITHUB_USER
      setx NUGET_AUTH_TOKEN YOUR_TOKEN
  -->

  <packageSources>
    <clear />

    <!-- Official feed: still needed for every third-party package. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- The organization: where Nur.Tricenter.* is published. -->
    <add key="Nur-tricenter" value="https://nuget.pkg.github.com/Nur-tricenter/index.json" />

  </packageSources>

</configuration>