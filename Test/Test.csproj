<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Catalog.Test</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Joseco.DDD.Core" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" />
    <PackageReference Include="PactNet" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Required by Test/IntegrationTest/RabbitMq: the broker round-trip, retry and dead-letter tests
      exercise the real publisher and the real consumer against a live AMQP broker, so the test
      project compiles against the library itself instead of only reaching it transitively through
      Catalog.WorkerService. RabbitMQ.Client (7.1.2) flows in transitively and is used to poll
      queue depth, read dead-letter headers and clean up the exchanges/queues the tests declare.
    -->
    <PackageReference Include="Joseco.Communication.External.RabbitMQ" />
    <!--
      Pin: Joseco.Communication.External.RabbitMQ 1.1.0 drags OpenTelemetry.Api 1.12.0, which
      carries advisory GHSA-g94r-2vxg-569j (NU1902). The shared kernel pins 1.16.0 for the same
      reason; this project stays above both so the whole graph converges instead of the test host
      resolving a different OpenTelemetry build than the code under test. Do NOT remove this pin
      unless the RabbitMQ package stops requesting OpenTelemetry.Api < 1.16.0.
    -->
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\src\Catalog.Domain\Catalog.Domain.csproj" />
    <ProjectReference Include="..\src\Catalog.App\Catalog.App.csproj" />
    <ProjectReference Include="..\src\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <!--
      Referenced so the WorkerService composition root (RabbitMqExtensions.AddCatalogRabbitMq and
      DefaultQueueRegistrar) can be unit-tested without a live broker.
    -->
    <ProjectReference Include="..\src\Catalog.WorkerService\Catalog.WorkerService.csproj" />
  </ItemGroup>

</Project>