<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Joseco.DDD.Core is declared here, not left to arrive transitively from Catalog.Domain, even
    though Domain references it. This layer uses DomainEvent, IUnitOfWork and Result<T> directly
    in its own signatures, and a dependency you compile against is one you own: if Domain moves
    that package to another version tomorrow, this project keeps building against the version it
    declared instead of silently inheriting a different one.
  -->
  <ItemGroup>
    <PackageReference Include="Joseco.DDD.Core" />
    <PackageReference Include="Joseco.Outbox.Contracts" />
    <!--
      Declared because the five PublishIntegrationEventWhen* handlers take an IExternalPublisher
      in their constructor and register it in DI. The interface is the publishing abstraction, not
      a transport: the concrete broker arrives in the worker, so Application still has no
      dependency on RabbitMQ.
    -->
    <PackageReference Include="Joseco.Communication.External.Contracts" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\contracts\Catalog.Contracts.csproj" />
    <ProjectReference Include="..\Catalog.Domain\Catalog.Domain.csproj" />
  </ItemGroup>

</Project>