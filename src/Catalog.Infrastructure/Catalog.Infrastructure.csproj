<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Consul client, used by Catalog.Infrastructure/Consul/ServiceRegistration to register THIS
      instance in the service registry on start and deregister it on stop.

      Why this package sits here rather than in Catalog.App: ServiceRegistration.cs is a
      generic-host IHostedService that has no ASP.NET dependency at all ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â its only web-specific
      concern (reading the bound port) is declared as IServerPortResolver and answered by the web
      host. That makes Infrastructure the correct home for the class AND for its one dependency.

      What that costs Catalog.WorkerService, which references this project: nothing functional. The
      Consul client is a plain HTTP/DNS library ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â it does not pull in the ASP.NET Core shared
      framework, so the console host keeps building and running as a console app. It simply never
      calls AddConsulServiceRegistration, and it must not: the worker publishes to RabbitMQ, has no
      HTTP endpoint, and a gateway cannot route to it. Registration is opt-in per host, never a
      side effect of AddInfrastructure.
    -->
    <PackageReference Include="Consul" />
    <PackageReference Include="Joseco.DDD.Core" />
    <!-- Integration contracts now live in the shared kernel, so publisher and consumer
         compile against the same type instead of two drifting copies. -->
    <PackageReference Include="Nur.Tricenter.Integration" />
    <PackageReference Include="Joseco.Outbox.EFCore" />
    <!--
      The RabbitMQ transport. Infrastructure owns it because the consumer subscription is
      registered here: IdempotentConsumer is infrastructure, and it cannot be resolved without the
      library that will deliver to it. Catalog.Contracts declares the message shape only, and
      Catalog.Application stays free of any broker dependency.
    -->
    <PackageReference Include="Joseco.Communication.External.RabbitMQ" />
    <PackageReference Include="Joseco.Communication.External.Contracts" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!--
      Declared explicitly because ServiceRegistration implements IHostedService. It already arrived
      transitively at 9.0.3, and this pin matches that exact version so the graph converges instead
      of shifting. Referencing a type from an undeclared transitive package is a build that breaks
      the next time an unrelated package moves.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scrutor" />
    <!--
      OpenTelemetry.* and Serilog.* are NOT declared here any more: they arrive through
      Nur.Tricenter.Observability, which is where the AddObservability/UseLogging bodies and the
      meter collection list now live. Declaring them again on this side is what let the two hosts
      drift into collecting different meters; the kernel is the single place that decides.
    -->
  </ItemGroup>

  <ItemGroup>
    <!--
      The platform kernel arrives as a NuGet package, not as a project reference to a sibling
      folder. That is what makes this repository buildable on its own: `dotnet restore` resolves
      the package from the organization feed, so the checkout needs nothing else on disk and the
      Docker image builds from this folder as the context.
    -->
    <PackageReference Include="Nur.Tricenter.Observability" />
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
  </ItemGroup>

</Project>