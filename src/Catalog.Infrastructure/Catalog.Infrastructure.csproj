<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Consul client, used by Catalog.Infrastructure/Consul/ServiceRegistration to register THIS
      instance in the service registry on start and deregister it on stop.

      Why this package sits here rather than in Catalog.WebApi: ServiceRegistration.cs is a
      generic-host IHostedService that has no ASP.NET dependency at all — its only web-specific
      concern (reading the bound port) is declared as IServerPortResolver and answered by the web
      host. That makes Infrastructure the correct home for the class AND for its one dependency.

      What that costs Catalog.WorkerService, which references this project: nothing functional. The
      Consul client is a plain HTTP/DNS library — it does not pull in the ASP.NET Core shared
      framework, so the console host keeps building and running as a console app. It simply never
      calls AddConsulServiceRegistration, and it must not: the worker publishes to RabbitMQ, has no
      HTTP endpoint, and a gateway cannot route to it. Registration is opt-in per host, never a
      side effect of AddInfrastructure.
    -->
    <PackageReference Include="Consul" Version="1.7.14.7" />
    <PackageReference Include="Joseco.DDD.Core" Version="1.0.3" />
    <PackageReference Include="Joseco.Outbox.EFCore" Version="1.1.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0-preview.2" />
    <!--
      Declared explicitly because ServiceRegistration implements IHostedService. It already arrived
      transitively at 9.0.3, and this pin matches that exact version so the graph converges instead
      of shifting. Referencing a type from an undeclared transitive package is a build that breaks
      the next time an unrelated package moves.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0-preview.2.25163.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0-preview.2.25163.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="Scrutor" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
  </ItemGroup>

</Project>